# ScanZero Environment Configuration
# Copy this file to .env and fill in your API keys

# ============ DATABASE ============
DATABASE_URL=postgresql+asyncpg://scanzero:scanzero@localhost:5432/scanzero
REDIS_URL=redis://localhost:6379/0

# ============ SECURITY ============
SECRET_KEY=change-this-to-a-random-64-char-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ============ SCAN SETTINGS ============
CACHE_TTL_HOURS=6
SCAN_TIMEOUT_SECONDS=30

# ============ OSINT API KEYS ============
# Shodan: https://account.shodan.io (free: 100 queries/month)
SHODAN_API_KEY=

# Have I Been Pwned: https://haveibeenpwned.com/API/Key ($3.50/month)
HIBP_API_KEY=

# DeHashed: https://dehashed.com (paid, ~$5/month)
DEHASHED_API_KEY=
DEHASHED_EMAIL=

# Intelligence X: https://intelx.io (free tier available)
INTELX_API_KEY=

# Censys: https://search.censys.io (free: 250 queries/month)
CENSYS_API_ID=
CENSYS_API_SECRET=

# ============ AI / LLM ============
# Google Gemini: https://ai.google.dev (free: 60 req/min)
GEMINI_API_KEY=

# ============ OWASP ZAP ============
ZAP_API_URL=http://localhost:8080
ZAP_API_KEY=changeme

# ============ FRONTEND ============
NEXT_PUBLIC_API_URL=http://localhost:8000
