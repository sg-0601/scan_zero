# ScanZero Environment Configuration
# Copy this file to .env and fill in your API keys

# ============ DATABASE ============
DATABASE_URL=postgresql+asyncpg://scanzero:scanzero@localhost:5432/scanzero
REDIS_URL=redis://localhost:6379/0

# ============ SECURITY ============
SECRET_KEY=change-this-to-a-random-64-char-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ============ SCAN SETTINGS ============
CACHE_TTL_HOURS=6
SCAN_TIMEOUT_SECONDS=30

# ============ OSINT API KEYS ============
# Shodan: https://account.shodan.io (free: 100 queries/month)
SHODAN_API_KEY=

# VirusTotal (Censys Alternative): https://www.virustotal.com/gui/join-us (Free: 500 req/day)
VIRUSTOTAL_API_KEY=

# URLScan.io (IntelX Alternative): https://urlscan.io/user/signup (Free: 5,000 scans/month)
URLSCAN_API_KEY=

# LeakCheck (DeHashed Alternative): https://leakcheck.io (Free tier)
LEAKCHECK_API_KEY=

# AlienVault OTX (Threat Intel Alternative): https://otx.alienvault.com (100% Free Community)
OTX_API_KEY=

# ============ AI / LLM ============
# Google Gemini: https://ai.google.dev (free: 60 req/min)
GEMINI_API_KEY=

# ============ OWASP ZAP ============
ZAP_API_URL=http://localhost:8080
ZAP_API_KEY=changeme

# ============ FRONTEND ============
NEXT_PUBLIC_API_URL=http://localhost:8000
